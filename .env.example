# 大模型 API 配置已统一由 backend/config.json 管理：
#   - "chat" 块：对话模型（base_url / api_key / model）
#   - "embedding" 块：向量化模型（base_url / api_key / model），与 chat 可用不同服务
# 下列环境变量为可选覆盖项（优先级高于 config.json），不设置则以 config.json 为准。

# 对话模型覆盖项
# ARK_CHAT_BASE_URL=
# ARK_CHAT_API_KEY=
# ARK_CHAT_MODEL=

# 向量化模型覆盖项
# ARK_EMBEDDING_BASE_URL=
# ARK_EMBEDDING_API_KEY=
# ARK_EMBEDDING_MODEL=
# ARK_EMBEDDING_RPM=3
# ARK_EMBEDDING_TPM=10000

VECTOR_BACKEND=milvus
RAG_MILVUS_URI=./milvus_demo.db
